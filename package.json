{
  "name": "@ahmed-khaled-z/zadloop-sidebar-panels",
  "version": "1.0.0",
  "description": "Choose which panels show in the sidebar and which move into its More menu.",
  "license": "MIT",
  "author": "ahmed-khaled-z",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ahmed-khaled-z/zadloop-sidebar-panels.git"
  },
  "homepage": "https://github.com/ahmed-khaled-z/zadloop-sidebar-panels#readme",
  "keywords": [
    "zadloop",
    "dsh",
    "plugin"
  ],
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "dsh": ">=0.2.2-rc.1"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  }
}
